{
  "name": "youtime-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "test": "node --test scripts/seo.test.mjs scripts/header.test.mjs scripts/publisher.test.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^2.0.126",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.9.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
